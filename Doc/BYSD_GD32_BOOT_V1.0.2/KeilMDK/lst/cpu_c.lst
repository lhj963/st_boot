Nvoid lfos_thread_stack_init(OS_STK **sp,void *thread_proc)
N{
N#if 0
S	*(--(*sp)) = (OS_STK)thread_proc;
S	*(--(*sp)) = 0x44444444;
S	*(--(*sp)) = 0x55555555;
S	*(--(*sp)) = 0x66666666;
S	*(--(*sp)) = 0x77777777;
S	*(--(*sp)) = 0x88888888;
S	*(--(*sp)) = 0x99999999;
S	*(--(*sp)) = 0xAAAAAAAA;
S	*(--(*sp)) = 0xBBBBBBBB;
S	*(--(*sp)) = 0xCCCCCCCC;
N#else
N	*(--(*sp)) = 0x01000000u;								//xPSR
N	*(--(*sp)) = (OS_STK)thread_proc;						//entry point
N	*(--(*sp)) = 0xEEEEEEEE;								//LR
N	*(--(*sp)) = 0xCCCCCCCC;								//R12
N	*(--(*sp)) = 0x33333333;								//R3
N	*(--(*sp)) = 0x22222222;								//R2
N	*(--(*sp)) = 0x11111111;								//R1
N	*(--(*sp)) = 0x00000000;								//R0
N
N	*(--(*sp)) = 0xBBBBBBBB;								//R11
N	*(--(*sp)) = 0xAAAAAAAA;								//R10
N	*(--(*sp)) = 0x99999999;								//R9
N	*(--(*sp)) = 0x88888888;								//R8
N	*(--(*sp)) = 0x77777777;								//R7
N	*(--(*sp)) = 0x66666666;								//R6
N	*(--(*sp)) = 0x55555555;								//R5
N	*(--(*sp)) = 0x44444444;								//R4
N#endif
N
N}
