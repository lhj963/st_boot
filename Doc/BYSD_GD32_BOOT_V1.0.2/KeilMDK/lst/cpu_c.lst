N#include "lfos_cfg.h"
N
N#define SYS_THREAD_STK_SIZE 	64
N
Ntypedef struct tagLFOS_SEM
N{
N	void *pName;	//信号量名称
N	INT8U sem_cnt;	//信号量数量
N	INT32U timeout;
N}LFOS_SEM;
N
Ntypedef struct tagLFOSThread
N{
N	OS_STK *sp;				//栈顶指针
N	OS_STK *bottom;			//栈底指针
N	OS_STK *sp_init_ptr;	//堆顶初始指针
N	INT32U stack_freed;		//空闲堆栈
N
N	INT8U status;			//线程状态
N	INT32U dly_tick;		//延时节拍
N	INT32U use_cpu_tick;	//占用CPU的时间
N	LFOS_SEM *pSem;			//信号量
N
N}LFOSThread;
N
N//需要移植的函数
Nextern void cpu_int_en(void);
Nextern void cpu_int_dis(void);
Nextern void start_thread(void);
Nextern void context_sw(void);
Nextern void context_sw_int(void);
Nextern void lfos_thread_stack_init(OS_STK **sp,void *thread_proc);
N
Nextern LFOSThread *pCurThread;
Nextern LFOSThread *pHighThread;
N
N
N
N//调试相关的函数
Nextern LFOSThread *lfos_get_thread_ptr(INT8U thread_id);
Nextern OS_STK *lfos_get_sys_thread_stk_ptr(void);
N
N
N//需要在中断里面调用的函数
Nextern void lfos_tick(void);
Nextern void lfos_enter_int(void);
Nextern void lfos_exit_int(void);
N
N
N//API接口
Nextern void lfos_init(void);
Nextern int lfos_create_thread(INT8U thread_id,void (*thread_proc)(void),
N								OS_STK *sp,OS_STK *bottom);
Nextern void lfos_start(void);
Nextern void lfos_sleep(unsigned int t);
Nextern INT32U lfos_stack_used(unsigned char thread_id);
Nextern INT32U lfos_stack_freed(unsigned char thread_id);
Nextern INT16U lfos_get_version(void);
N
N
N//信号量
Nextern int lfos_create_sem(LFOS_SEM *pSem,void *pName,INT8U cnt);
Nextern int lfos_sem_pend(LFOS_SEM *pSem,INT32U timeout);
Nextern int lfos_sem_post(LFOS_SEM *pSem);
N
N
N//mem_lib_id:内存库ID
Nextern int lfos_create_mem(INT8U mem_lib_id,void *ptr,INT32U block_size,INT32U block_cnt);
Nextern void *lfos_mem_malloc(INT8U mem_lib_id);
Nextern int lfos_mem_free(INT8U mem_lib_id,void *ptr);
Nextern unsigned int lfos_mem_get_block_size(INT8U mem_lib_id);
