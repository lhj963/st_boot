N
NLFOS g_os = {0};
NLFOSThread osthread[MAX_THREAD_CNT + 1] = {0};
XLFOSThread osthread[16 + 1] = {0};
NLFOSThread *pCurThread = 0;
NLFOSThread *pHighThread = 0;
N
N
N
NINT8U cur_thread_id = 0;		//当前运行的线程ID
NINT8U rdy_high_id = 0;			//就绪的高优先级线程ID
N
NINT32U rdy_tbl = 0;				//每个位代表每个线程状态是否就绪
NINT8U int_nest_ctr;				//中断嵌套计数
N
N
NOS_STK sys_thread_stk[SYS_THREAD_STK_SIZE] = {0};
XOS_STK sys_thread_stk[64] = {0};
N
NOS_STK *lfos_get_sys_thread_stk_ptr(void)
N{
N	return sys_thread_stk;
N}
N
NLFOSThread *lfos_get_thread_ptr(INT8U thread_id)
N{
N	if (thread_id > MAX_THREAD_CNT) return 0;
X	if (thread_id > 16) return 0;
N
N	return osthread + thread_id;
N}
N
Nunsigned char find_ready_thread_id(void)
N{
N	INT8U i = 0;
N
N	for (i = 0; i < MAX_THREAD_CNT; i++)
X	for (i = 0; i < 16; i++)
N	{
N		if (rdy_tbl & (1 << i))
N		{
N			return i;
N		}
N	}
N
N	return MAX_THREAD_CNT;
X	return 16;
N}
