Ntypedef enum tagThreadStatus
N{
N	ThreadStatus_NO_CREATE = 0,		//未创建状态
N
N	ThreadStatus_RDY,			//就绪态
N	ThreadStatus_RUN,			//运行态
N	ThreadStatus_DLY,			//延时态
N
N	ThreadStatus_PENDING,			//等待信号
N
N	ThreadStatus_BLOCK,			//阻塞态
N	ThreadStatus_SUPEND, 		//挂起状态
N
N}ThreadStatus;
N
N
Ntypedef struct tagLFOS
N{
N	INT32U idle_ctr;			//空闲线程计数
N
N	INT32U flag;				//标志
N}LFOS;
