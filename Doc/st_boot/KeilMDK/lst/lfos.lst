NINT32U lfos_stack_used(unsigned char thread_id)
N{
N	INT32U all = 0;
N	if (thread_id > MAX_THREAD_CNT) return 0;
X	if (thread_id > 16) return 0;
N
N	if (osthread[thread_id].sp_init_ptr > osthread[thread_id].bottom)
N	{
N		all = osthread[thread_id].sp_init_ptr - osthread[thread_id].bottom + 1;
N	}
N	else
N	{
N		all = osthread[thread_id].bottom - osthread[thread_id].sp_init_ptr + 1;
N	}
N
N	return all - osthread[thread_id].stack_freed;
N}
N
NINT32U lfos_stack_freed(unsigned char thread_id)
N{
N	if (thread_id > MAX_THREAD_CNT) return 0;
X	if (thread_id > 16) return 0;
N
N	return osthread[thread_id].stack_freed;
N}
N
Nvoid lfos_sleep(unsigned int t)
N{
N	cpu_int_dis();
N	_clr_bit(rdy_tbl,cur_thread_id);
X	rdy_tbl &= (~(1 << cur_thread_id));
N	osthread[cur_thread_id].status = (INT8U)ThreadStatus_DLY;
N	osthread[cur_thread_id].dly_tick = t;
N
N	sched();
N}
N
Nvoid lfos_tick(void)
N{
N	INT8U i = 0;
N
N	for (i = 0; i < MAX_THREAD_CNT; i++)
X	for (i = 0; i < 16; i++)
N	{
N		if (osthread[i].status == ThreadStatus_DLY)
N		{
N			if (osthread[i].dly_tick)
N			{
N				osthread[i].dly_tick--;
N			}
N			else
N			{
N				osthread[i].status = ThreadStatus_RDY;			//就绪态
N				_set_bit(rdy_tbl,i);
X				rdy_tbl |= (1 << i);
N			}
N		}
N		else if (osthread[i].status == ThreadStatus_PENDING)
N		{
N			if (osthread[i].pSem)
N			{
N				if (osthread[i].pSem->sem_cnt)
N				{
N					osthread[i].status = ThreadStatus_RDY;		//就绪态
N					_set_bit(rdy_tbl,i);
X					rdy_tbl |= (1 << i);
N					osthread[i].pSem->sem_cnt--;
N					osthread[i].pSem = 0;
N				}
N				else if (osthread[i].pSem->timeout)
N				{
N					osthread[i].pSem->timeout--;
N					if (osthread[i].pSem->timeout == 0)				//等待超时
N					{
N						osthread[i].status = ThreadStatus_RDY;		//就绪态
N						_set_bit(rdy_tbl,i);
X						rdy_tbl |= (1 << i);
N						osthread[i].pSem = 0;
N					}
N				}
N
N			}
N		}
N		else if (osthread[i].status == ThreadStatus_BLOCK)
N		{
N
N		}
N		#if 0
S		else if (osthread[i].status == ThreadStatus_RUN)
S		{
S			osthread[i].use_cpu_tick++;
S			//该线程占用CPU时间太多 杀死该线程
S			if (osthread[i].use_cpu_tick > MAX_THREAD_USE_TICK_CNT)
S			{
S				osthread[i].status = ThreadStatus_SUPEND;
S				_clr_bit(rdy_tbl,i);
S				sched_int();
S			}
S		}
N		#endif
N		//清除占用CPU时间计时器
N		if (osthread[i].status != ThreadStatus_RUN)
N		{
N			osthread[i].use_cpu_tick = 0;
N		}
N
N	}
N
N	//if (sched_flag)
N	{
N		//sched_int();
N	}
N}
N
N#define SET_STACK_HI_TO_LOW()	_set_bit(g_os.flag,0)
N#define SET_STACK_LOW_TO_HI()   _clr_bit(g_os.flag,0)
N#define IS_STACK_HI_TO_LOW()	_get_bit(g_os.flag,0)
N
N
Nint lfos_create_thread(INT8U thread_id,void (*thread_proc)(void),
N								OS_STK *sp,OS_STK *bottom)
N{
N	if (thread_id > MAX_THREAD_CNT) return 1;
X	if (thread_id > 16) return 1;
N
N	//检查该thread_id是否有线程存在 有线程存在 则不能创建该线程
N	if (osthread[thread_id].sp || osthread[thread_id].sp_init_ptr || osthread[thread_id].bottom)
N	{
N		return 2;
N	}
N
N	osthread[thread_id].dly_tick = 0;
N	osthread[thread_id].sp_init_ptr = sp;
N	osthread[thread_id].sp = sp;
N	osthread[thread_id].bottom = bottom;
N	osthread[thread_id].status = ThreadStatus_RDY;
N	_set_bit(rdy_tbl,thread_id);
X	rdy_tbl |= (1 << thread_id);
N	if (sp > bottom)
N	{
N		SET_STACK_HI_TO_LOW();
X		g_os . flag |= (1 << 0);
N	}
N	else
N	{
N		SET_STACK_LOW_TO_HI();
X		g_os . flag &= (~(1 << 0));
N	}
N
N	lfos_thread_stack_init(&osthread[thread_id].sp,thread_proc);
N	return 0;
N}
N
Nvoid check_stack_used(void)
N{
N	INT8U i = 0;
N	OS_STK *pstk = 0;
N	INT32U freed = 0;
N
N	for (i = 0; i <= MAX_THREAD_CNT; i++)
X	for (i = 0; i <= 16; i++)
N	{
N		if (osthread[i].sp_init_ptr)	//osthread[i].sp_init_ptr不等于0表示该线程ID被创建
N		{
N			pstk = osthread[i].bottom;
N			freed = 0;
N			if (osthread[i].bottom > osthread[i].sp_init_ptr)	//堆栈由低向高生长
N			{
N				while (*pstk == 0)
N				{
N					freed++;
N					pstk--;
N				}
N			}
N			else												//堆栈由高向低生长
N			{
N				while (*pstk == 0)
N				{
N					freed++;
N					pstk++;
N				}
N			}
N			osthread[i].stack_freed = freed;
N		}
N	}
N}
N
Nvoid sys_thread(void)
N{
N	while (1)
N	{
N		//check_stack_used();
N		g_os.idle_ctr++;
N		sched();
N	}
N}
N
Nvoid lfos_init(void)
N{
N	g_os.flag = 0;
N	g_os.idle_ctr = 0;
N
N	pCurThread = 0;
N	pHighThread = 0;
N	rdy_tbl = 0;
N	rdy_high_id = 0;
N	cur_thread_id = 0;
N}
N
N
N
Nvoid lfos_start(void)
N{
N	if (IS_STACK_HI_TO_LOW())
X	if ((g_os . flag & (1 << 0)))
N	{
N		lfos_create_thread(MAX_THREAD_CNT,sys_thread,&sys_thread_stk[SYS_THREAD_STK_SIZE - 1],&sys_thread_stk[0]);
X		lfos_create_thread(16,sys_thread,&sys_thread_stk[64 - 1],&sys_thread_stk[0]);
N	}
N	else
N	{
N		lfos_create_thread(MAX_THREAD_CNT,sys_thread,&sys_thread_stk[0],&sys_thread_stk[SYS_THREAD_STK_SIZE - 1]);
X		lfos_create_thread(16,sys_thread,&sys_thread_stk[0],&sys_thread_stk[64 - 1]);
N	}
N
N	rdy_high_id = find_ready_thread_id();
N	cur_thread_id = rdy_high_id;
N	pCurThread = osthread + rdy_high_id;
N	pHighThread = osthread + rdy_high_id;
N	start_thread();
N}
N
N
N/*********************************信号量SEM*********************************/
N
Nint lfos_create_sem(LFOS_SEM *pSem,void *pName,INT8U cnt)
N{
N	if (pSem == 0)
N	{
N		return 1;
N	}
N
N	pSem->pName = pName;
N	pSem->sem_cnt = cnt;
N	return 0;
N}
N
Nint lfos_sem_pend(LFOS_SEM *pSem,INT32U timeout)
N{
N	if (pSem == 0) return 1;
N
N	//存在可用的信号量 直接退出 否则就进入等待状态 让出CPU使用权
N	if (pSem->sem_cnt)
N	{
N		pSem->sem_cnt--;
N		return 0;
N	}
N
N	//timeout为-1 表示不进行阻塞
N	if (timeout == (INT32U)-1)
N	{
N		return 0;
N	}
N	cpu_int_dis();
N	pSem->timeout = timeout;
N	osthread[cur_thread_id].pSem = pSem;
N	osthread[cur_thread_id].status = ThreadStatus_PENDING;
N	_clr_bit(rdy_tbl,cur_thread_id);
X	rdy_tbl &= (~(1 << cur_thread_id));
N	sched();
N	return 2;
N}
N
Nint lfos_sem_post(LFOS_SEM *pSem)
N{
N	if (pSem == 0) return 1;
N	pSem->sem_cnt++;
N	return 0;
N}
N
N
N
N/*********************************动态内存管理MEM*********************************/
N
Ntypedef struct tagLFOS_MEM
N{
N	INT8U *ptr;
N	INT32U block_size;
N	INT32U block_cnt;
N	INT32U used_tbl;
N}LFOS_MEM;
N
N#define MAX_MEM_LIB_CNT 8
N
NLFOS_MEM s_astLFOS_MEM[MAX_MEM_LIB_CNT] = {0};
XLFOS_MEM s_astLFOS_MEM[8] = {0};
N
N//mem_lib_id:内存库ID
Nint lfos_create_mem(INT8U mem_lib_id,void *ptr,INT32U block_size,INT32U block_cnt)
N{
N	if (mem_lib_id >= MAX_MEM_LIB_CNT)
X	if (mem_lib_id >= 8)
N	{
N		return 1;
N	}
N
N	if ((ptr == 0) || (block_cnt == 0) || (block_size == 0)) return 2;
N
N	if (block_cnt > 32) block_cnt = 32;
N
N	s_astLFOS_MEM[mem_lib_id].ptr = (INT8U *)ptr;
N	s_astLFOS_MEM[mem_lib_id].block_size = block_size;
N	s_astLFOS_MEM[mem_lib_id].block_cnt = block_cnt;
N	s_astLFOS_MEM[mem_lib_id].used_tbl = 0;
N	return 0;
N}
N
N
Nvoid *lfos_mem_malloc(INT8U mem_lib_id)
N{
N	INT8U i = 0;
N	INT32U cnt = 0;
N
N	if (mem_lib_id >= MAX_MEM_LIB_CNT)
X	if (mem_lib_id >= 8)
N	{
N		return 0;
N	}
N
N	//查找空闲内存块
N	cnt = s_astLFOS_MEM[mem_lib_id].block_cnt;
N
N	for (i = 0; i < cnt; i++)
N	{
N		if ((s_astLFOS_MEM[mem_lib_id].used_tbl & (1 << i)) == 0)
N		{
N			break;
N		}
N	}
N
N	if (i >= cnt)
N	{
N		return 0;
N	}
N	else
N	{
N		_set_bit(s_astLFOS_MEM[mem_lib_id].used_tbl,i);
X		s_astLFOS_MEM[mem_lib_id]. used_tbl |= (1 << i);
N		return (void *)(s_astLFOS_MEM[mem_lib_id].ptr + i * s_astLFOS_MEM[mem_lib_id].block_size);
N	}
N}
N
Nint lfos_mem_free(INT8U mem_lib_id,void *ptr)
N{
N	INT32U num = 0;
N	INT32U idx = 0;
N
N	if (mem_lib_id >= MAX_MEM_LIB_CNT)
X	if (mem_lib_id >= 8)
N	{
N		return 1;
N	}
N	if (ptr == 0)
N	{
N		return 2;
N	}
N
N	num = (INT8U *)ptr - s_astLFOS_MEM[mem_lib_id].ptr;
N	if (num % s_astLFOS_MEM[mem_lib_id].block_size)
N	{
N		return 3;
N	}
N	idx = num / s_astLFOS_MEM[mem_lib_id].block_size;
N	if (idx >= s_astLFOS_MEM[mem_lib_id].block_cnt)
N	{
N		return 4;
N	}
N
N	//清除使用标志
N	_clr_bit(s_astLFOS_MEM[mem_lib_id].used_tbl,idx);
X	s_astLFOS_MEM[mem_lib_id]. used_tbl &= (~(1 << idx));
N
N	return 0;
N}
N
Nunsigned int lfos_mem_get_block_size(INT8U mem_lib_id)
N{
N	return s_astLFOS_MEM[mem_lib_id].block_size;
N}
N
