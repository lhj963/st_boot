Nextern void triger_pendsv(void);
N//进行一次任务调度
Nvoid sched(void)
N{
N	//关中断
N	//cpu_int_dis();
N
N	rdy_high_id = find_ready_thread_id();
N	if (rdy_high_id == cur_thread_id)
N	{
N		cpu_int_en();
N		return ;
N	}
N
N	//关中断
N	//cpu_int_dis();
N	pCurThread = osthread + cur_thread_id;
N	pHighThread = osthread + rdy_high_id;
N	osthread[cur_thread_id].use_cpu_tick = 0;
N	osthread[rdy_high_id].status = ThreadStatus_RUN;
N	cur_thread_id = rdy_high_id;
N	cpu_int_en();
N	context_sw();
N}
N
N//进行一次任务调度
Nvoid sched_int(void)
N{
N	//关中断
N	//cpu_int_dis();
N	rdy_high_id = find_ready_thread_id();
N	if (rdy_high_id == cur_thread_id)
N	{
N		cpu_int_en();
N		return ;
N	}
N
N	//关中断
N	//cpu_int_dis();
N	pCurThread = osthread + cur_thread_id;
N	pHighThread = osthread + rdy_high_id;
N	osthread[cur_thread_id].use_cpu_tick = 0;
N	osthread[rdy_high_id].status = ThreadStatus_RUN;
N	cur_thread_id = rdy_high_id;
N	cpu_int_en();
N	context_sw_int();
N}
N
Nvoid lfos_enter_int(void)
N{
N	if (int_nest_ctr < 250) int_nest_ctr++;
N}
N
Nvoid lfos_exit_int(void)
N{
N	if (int_nest_ctr) int_nest_ctr--;
N}
